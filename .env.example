# ============================================================
# Public Supabase configuration
# Safe to expose to the browser.
# ============================================================

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ============================================================
# Server-only Supabase configuration
# Never expose this value to browser code.
# ============================================================

SUPABASE_SERVICE_ROLE_KEY=

# ============================================================
# Supabase CLI
# Used only for database type generation.
# ============================================================

SUPABASE_PROJECT_ID=

# ============================================================
# Application
# ============================================================

NEXT_PUBLIC_APP_NAME=Scheduler

# Full application origin, including protocol.
# No trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Canonical app URL for server-side notification/manage-link generation.
# If omitted, NEXT_PUBLIC_APP_URL is used as fallback.
PUBLIC_APP_URL=http://localhost:3000

# Root hostname used for future tenant-subdomain routing.
# Do not include protocol.
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000

# 32-byte key material for appointment token encryption (server-only).
# Accepted formats: 64-char hex, base64/base64url, or raw 32-byte text.
APPOINTMENT_TOKEN_ENCRYPTION_KEY=

# ============================================================
# Self-service integration tests (optional)
# ============================================================

TEST_SELF_SERVICE_TENANT_ID=
TEST_SELF_SERVICE_APPOINTMENT_ID=

# Provide one auth option:
TEST_SELF_SERVICE_OWNER_JWT=
# or
TEST_SELF_SERVICE_OWNER_EMAIL=
TEST_SELF_SERVICE_OWNER_PASSWORD=



# ============================================================
# Notifications (Milestone 6.12)
# ============================================================

# Email provider: "console" (dev, logs only) or "nodemailer" (production SMTP)
EMAIL_PROVIDER=console

# Sender email address (required for nodemailer provider)
NOTIFICATION_FROM_EMAIL=

# SMTP configuration (required only when EMAIL_PROVIDER=nodemailer)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=true

# Secret for authenticating the notification processing route
# POST /api/internal/notifications/process
NOTIFICATION_PROCESSOR_SECRET=

# ============================================================
# Polar Billing (Milestone 7.1)
# ============================================================

# Polar API base URL (defaults to https://api.polar.sh)
POLAR_API_BASE_URL=https://api.polar.sh

# Polar API access token (server-only)
POLAR_ACCESS_TOKEN=

# Polar mode marker for diagnostics/config parity (e.g. sandbox, production)
POLAR_SERVER=sandbox

# Optional: constrain synchronization to a specific Polar organization context
POLAR_ORGANIZATION_ID=

# Webhook signature secret for POST /api/webhooks/polar
POLAR_WEBHOOK_SECRET=

