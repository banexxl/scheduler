# ============================================================
# PUBLIC — Safe to expose to browser
# ============================================================

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_APP_NAME=Scheduler
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000

# ============================================================
# SERVER SECRETS — Never expose to browser/client
# ============================================================

# Supabase service-role key (bypasses RLS — server-only)
SUPABASE_SERVICE_ROLE_KEY=

# Appointment token encryption (32-byte key: 64-char hex, base64, or raw)
APPOINTMENT_TOKEN_ENCRYPTION_KEY=

# Internal API processor authentication
NOTIFICATION_PROCESSOR_SECRET=

# ============================================================
# EMAIL — Required for production notifications
# ============================================================

# Provider: "console" (dev — logs only) or "nodemailer" (production SMTP)
EMAIL_PROVIDER=console

# Sender address (required when EMAIL_PROVIDER=nodemailer)
NOTIFICATION_FROM_EMAIL=

# SMTP (required when EMAIL_PROVIDER=nodemailer)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=true

# ============================================================
# POLAR BILLING — Optional (existing integration)
# ============================================================

POLAR_API_BASE_URL=https://api.polar.sh
POLAR_ACCESS_TOKEN=
POLAR_SERVER=sandbox
POLAR_ORGANIZATION_ID=
POLAR_WEBHOOK_SECRET=

# Per-endpoint webhook secrets (each Polar webhook has its own secret)
POLAR_ORGANIZATION_WEBHOOK_SECRET=
POLAR_CHECKOUT_WEBHOOK_SECRET=
POLAR_BENEFIT_WEBHOOK_SECRET=
POLAR_PRODUCT_WEBHOOK_SECRET=
POLAR_DISCOUNT_WEBHOOK_SECRET=
POLAR_REFUND_WEBHOOK_SECRET=
POLAR_SUBSCRIPTION_WEBHOOK_SECRET=
POLAR_ORDER_WEBHOOK_SECRET=
POLAR_CUSTOMER_WEBHOOK_SECRET=

# ============================================================
# APPLICATION — Server canonical URL
# ============================================================

# Canonical server-side URL for link generation (emails, tokens).
# Falls back to NEXT_PUBLIC_APP_URL if unset.
PUBLIC_APP_URL=http://localhost:3000

# ============================================================
# DEVELOPMENT / CLI — Not required for production
# ============================================================

SUPABASE_PROJECT_ID=

# ============================================================
# TESTING — Only for integration/E2E test runs
# ============================================================

# E2E_TEST_MODE=true
# TEST_BASE_URL=http://localhost:3000
# TEST_TENANT_SLUG=test-biznis
# TEST_PUBLIC_TENANT_SLUG=test-biznis

# Test users (shared password, different roles)
# TEST_ADMIN_USER_NAME=admin@example.com       (platform_admins member)
# TEST_TENANT_USER_NAME=tenant@example.com     (tenant owner for TEST_TENANT_SLUG)
# TEST_CUSTOMER_USER_NAME=customer@example.com (customer account)
# TEST_USER_PASSWORD=

# Legacy (fallback — use TEST_TENANT_USER_NAME instead)
# TEST_USER_NAME=

# ============================================================
# LOGGING — Optional
# ============================================================

# LOG_LEVEL=info  (debug|info|warn|error — defaults to info in production)
