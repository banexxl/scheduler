{
  "name": "scheduler",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "clean": "rimraf .next",
    "db:types": "node scripts/generate-database-types.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --exclude '**/integration/**' --exclude '**/e2e/**'",
    "test:integration": "cross-env E2E_TEST_MODE=true vitest run tests/integration/",
    "test:integration:required": "cross-env E2E_TEST_MODE=true INTEGRATION_REQUIRED=1 vitest run tests/integration/",
    "test:self-service:integration": "vitest run features/appointments/self-service/appointment-self-service.integration.test.ts",
    "test:self-service:integration:required": "node scripts/check-self-service-integration-env.mjs && cross-env SELF_SERVICE_INTEGRATION_REQUIRED=1 vitest run features/appointments/self-service/appointment-self-service.integration.test.ts",
    "test:all": "npm run build && npm run start npm run test && npm run test:integration",
    "test:e2e": "npx playwright test",
    "test:e2e:smoke": "npx playwright test --grep @smoke",
    "seed:e2e": "npx tsx tests/fixtures/e2e-seed.ts",
    "reset:test-tenant": "npx tsx scripts/reset-test-tenant.ts",
    "verify:rc": "npm run lint && npm run type-check && npm run build && npm run start && npm run test && npm run test:integration:required",
    "build:all": "npm run lint && npm run type-check && npm run build && npm run start && npm run test",
    "build:run": "npm run db:types && npm run lint && npm run type-check && npm run build && npm run start && npm run test"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/material": "^7.1.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.1",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "formik": "^2.4.6",
    "next": "16.3.0",
    "nodemailer": "9.0.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "yup": "^1.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "8.0.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "cross-env": "^7.0.3",
    "dotenv": "^17.4.2",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.0",
    "rimraf": "^6.1.3",
    "supabase": "^2.111.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.10"
  }
}