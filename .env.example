# ============================================================
# LOGGING — Optional (debug|info|warn|error — defaults to info in production)
# ============================================================

LOG_LEVEL=info

# ============================================================
# Public Supabase configuration
# Safe to expose to the browser.
# ============================================================

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ============================================================
# Server-only Supabase configuration
# Never expose this value to browser code.
# ============================================================

SUPABASE_SERVICE_ROLE_KEY=

# ============================================================
# Supabase CLI
# Used only for database type generation.
# ============================================================

SUPABASE_PROJECT_ID=

# ============================================================
# Application
# ============================================================

NEXT_PUBLIC_APP_NAME=Scheduler

# Full application origin, including protocol.
# No trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Root hostname used for future tenant-subdomain routing.
# Do not include protocol.
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000

# ============================================================
# Email
# ============================================================
EMAIL_PROVIDER=nodemailer
NOTIFICATION_FROM_EMAIL=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=true

# ============================================================
# Test
# ============================================================
E2E_TEST_MODE=true
TEST_BASE_URL=http://localhost:3000
TEST_TENANT_SLUG=moj-biznis
TEST_ADMIN_USER_NAME=
TEST_TENANT_USER_NAME=
TEST_CUSTOMER_USER_NAME=
TEST_USER_PASSWORD=
TEST_TENANT_SLUG=moj-biznis

# ============================================================
# POLAR SANDBOX BILLING — Optional (existing integration)
# ============================================================
POLAR_API_BASE_URL=https://sandbox-api.polar.sh/
POLAR_ACCESS_TOKEN=
POLAR_SERVER=sandbox
POLAR_ORGANIZATION_ID=
POLAR_BENEFIT_WEBHOOK_SECRET=
POLAR_CHECKOUT_WEBHOOK_SECRET=
POLAR_ORGANIZATION_WEBHOOK_SECRET=
POLAR_PRODUCT_WEBHOOK_SECRET=
POLAR_REFUND_WEBHOOK_SECRET=
POLAR_SUBSCRIPTION_WEBHOOK_SECRET=
POLAR_ORDER_WEBHOOK_SECRET=
POLAR_CUSTOMER_WEBHOOK_SECRET=
POLAR_DISCOUNT_WEBHOOK_SECRET=

# ============================================================
# WHOP
# ============================================================
WHOP_API_KEY=